# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Restart the site after changing anything here. When deploying, add the same variables
# in your hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# ── Website address (used for Google/SEO links, sitemap and share previews) ──
NEXT_PUBLIC_SITE_URL=https://www.glamhuman.in

# ── 1. Booking email (Gmail SMTP) ──
# Gmail account that sends the booking emails
SMTP_USER=glamhumanofficial@gmail.com
# Gmail App Password (16 characters, no spaces) — NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASS=
# Optional: where bookings are delivered (defaults to the salon email in lib/data.js)
# BOOKING_TO=glamhumanofficial@gmail.com

# ── 2. Google Sheet booking log ──
# Setup steps are at the top of google-apps-script/BookingLog.gs
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# ── 3. WhatsApp booking confirmation to the customer (optional — leave empty to keep it off) ──
# WhatsApp Business Cloud API (Meta). Template variables are explained in lib/integrations/whatsapp.js
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANG=en
